# =============================================================================
# معمار المنزل — متغيرات البيئة
# انسخ هذا الملف إلى .env.local واملأ القيم. لا ترفع .env.local إلى git أبداً.
# =============================================================================

# --- Supabase (إلزامي) ---
# من لوحة Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# المفتاح العام (publishable) — آمن للمتصفح لأن الصلاحيات محكومة بسياسات RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# المفتاح السري (secret) — للخادم فقط. لا تضع NEXT_PUBLIC_ قبله أبداً.
SUPABASE_SECRET_KEY="sb_secret_..."

# --- الموقع ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# ملح لبصمة عنوان IP (تحديد معدل نموذج التواصل). أي نص عشوائي طويل.
IP_HASH_SALT="replace-with-a-long-random-string"

# --- بيانات التواصل الظاهرة في التذييل (اختياري — تُخفى إن كانت فارغة) ---
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_WHATSAPP=""
NEXT_PUBLIC_CONTACT_EMAIL=""

# --- دخول الاختبار (التطوير المحلي فقط) ---
# يعمل فقط عندما NODE_ENV ليس production وهذه القيمة true. لا يعمل على Vercel إطلاقاً.
ENABLE_DEV_LOGIN="false"

# --- الذكاء الاصطناعي لتوليد الصور (المرحلة الثالثة) ---
# اتركه فارغاً لتعمل المنصة بوضع "الخدمة غير مُعدّة" دون عرض صور وهمية.
AI_IMAGE_PROVIDER=""
# مفتاح المزود المختار يُضاف هنا عند اعتماد المزود (خادم فقط).

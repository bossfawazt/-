# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file — it is already git-ignored.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://touq:touq_dev_password@localhost:5432/touq_dev?schema=public"

# --- NextAuth (Auth.js v5) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- UploadThing (product/verification media storage) ---
UPLOADTHING_TOKEN="replace-with-uploadthing-token"

# --- SMS / WhatsApp OTP provider ---
# No provider is wired up yet (see docs/ARCHITECTURE-touq.md #14 Future Integrations).
# Until then, OTP codes are generated server-side and logged to the console in development.
OTP_PROVIDER="dev-console"
